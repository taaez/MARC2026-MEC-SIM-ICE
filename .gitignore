# Delivered inside the content image, not tracked in git.
# simulation_app/ (platform source) and scenarios/ ship inside the content image; the platform and
# `marc.sh select` read them from there, so they are intentionally absent from this repository.
/simulation_app/
/scenarios/
/resources/
/results/
/trainer_output/
/.runtime-data/
simulation-platform/.env
**/__pycache__/
*.pyc
.pytest_cache/
.venv/
.DS_Store

# 학습된 가중치는 용량이 커서 git 으로 옮기지 않는다 (팀원에게 파일로 받아 배치).
# 제출 시에는 도커 이미지에 baking 해야 하므로 별도 조치가 필요하다.
demo/weights/
*.pt
*.pt.bak
# 채점 결과 원본은 results/(위에서 무시) 에 쌓이고, 보존할 실행만 아래로 복사한다.
!taejeong/validation/runs/*.jsonl

# 2026-08-29 폴더 정리: mec_sim_ice/test/ 를 코드/데이터셋/결과물로 분리하면서
# 데이터셋·학습 결과물(용량 큼, trainer_output/results 와 같은 성격)은 기존 컨벤션대로 git 밖에 둔다.
/mec_sim_ice/datasets/*
/mec_sim_ice/training_results/
# launch.sh 로컬 실행 산출물 (점수 로그, 팀 토큰) -- 비밀값 포함, git 밖.
/demo/results/
/demo/tokens.env

# 2026-08-30: 라이브 파이프라인이 실제로 로드하는 가중치 3종 + 서브모델 타일 설정만
# 예외로 커밋한다. 각 디렉토리를 통째로 막고(*) 필요한 파일 하나만 되살리는 방식이라,
# 데이터셋/학습 결과물 전체를 가진 PC에서 git add -A 를 해도 그 디렉토리 안의 다른
# 파일(학습 그래프·로그·last.pt·타일 이미지 수천 장 등)이 딸려 올라가지 않는다.
# (실제로 처음엔 *.pt 만 걸러질 뿐 results.png/args.yaml/last.pt 등은 안 막혀있던
# 구멍이 있었음 -- 아래는 그걸 고친 버전)

!/mec_sim_ice/demo_agents/weights/
/mec_sim_ice/demo_agents/weights/*
!/mec_sim_ice/demo_agents/weights/best.pt
!/mec_sim_ice/demo_agents/weights/yolo11m-pose.pt

!/mec_sim_ice/training/small_object_detection/runs/
/mec_sim_ice/training/small_object_detection/runs/*
!/mec_sim_ice/training/small_object_detection/runs/detect/
/mec_sim_ice/training/small_object_detection/runs/detect/*
!/mec_sim_ice/training/small_object_detection/runs/detect/small_t640_r2/
/mec_sim_ice/training/small_object_detection/runs/detect/small_t640_r2/*
!/mec_sim_ice/training/small_object_detection/runs/detect/small_t640_r2/weights/
/mec_sim_ice/training/small_object_detection/runs/detect/small_t640_r2/weights/*
!/mec_sim_ice/training/small_object_detection/runs/detect/small_t640_r2/weights/best.pt

!/mec_sim_ice/datasets/dataset_small_t640/
/mec_sim_ice/datasets/dataset_small_t640/*
!/mec_sim_ice/datasets/dataset_small_t640/tiling.json
